# Copy this file to .env and fill in your values.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for lesson generation (must support JSON mode).
# See the models your key can use: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Sentence-transformers embedding model (runs locally)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where Chroma stores its data and where source documents live
CHROMA_DIR=chroma_db
SOURCES_DIR=data/sources

# Frontend origin allowed by CORS (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

