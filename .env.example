# =============================================================================
# Root Docker Compose Environment Variables (Optional Overrides)
# Note: Backend application secrets (GROQ_API_KEY, GROQ_MODEL) belong in
#       backend/.env (copied from backend/.env.example).
# =============================================================================

# Host ports published by Docker Compose
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Frontend API base URL compiled into the bundle (/api uses the Nginx proxy)
VITE_API_BASE=/api

# Allowed CORS origin on the FastAPI backend
FRONTEND_ORIGIN=http://localhost:5173

# Sentence-transformers model pre-downloaded into the backend image at build time
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

